# Generate three DIFFERENT random secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters
INVITE_SECRET=replace-me-with-a-different-random-secret
LIVEKIT_API_SECRET=replace-me-with-another-random-secret
LIVEKIT_API_KEY=syncron-local
NODE_ENV=development
API_PORT=3001
APP_URL=http://localhost:3001
# Optional; the unpacked extension's ID from chrome://extensions, so the
# GET /join page can hand invite links off to it. Leave unset to fall back
# to the plain "install the extension" page.
EXTENSION_ID=
BETTER_AUTH_URL=http://localhost:3001
TRUSTED_ORIGINS=http://localhost:3001
DATABASE_URL=file:./data/syncron.db
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_INTERNAL_URL=http://localhost:7880
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SENDER=syncron@localhost.test
# Optional; set both to enable Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; set ALL five to switch from Mailpit to Gmail SMTP.
GMAIL_HOST=
GMAIL_PORT=
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
GMAIL_SENDER=
