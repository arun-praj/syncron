{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "*.ts"
  ],
  "exclude": ["apps/extension/.wxt", "apps/extension/.output", "apps/extension/**/*.tsx", "apps/extension/entrypoints", "apps/extension/src"]
}
