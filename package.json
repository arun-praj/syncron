{
  "name": "syncron",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env apps/api/src/index.ts",
    "start": "tsx --env-file-if-exists=.env apps/api/src/index.ts",
    "migrate": "tsx --env-file-if-exists=.env packages/db/src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/extension/tsconfig.json",
    "lint": "eslint .",
    "docker:smoke": "tsx scripts/docker-smoke.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@hono/node-ws": "^1.3.0",
    "better-auth": "1.7.4",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "livekit-server-sdk": "2.19.0",
    "nodemailer": "^7.0.0",
    "uuid": "^13.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/ws": "^8.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
