{
  "name": "syncron",
  "displayName": "Syncron",
  "version": "0.1.0",
  "description": "Watch parties in sync — shared playback, live chat, and calls without leaving YouTube.",
  "author": "Arun Prajapati",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "0.0.270",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.38",
    "prettier": "3.2.4",
    "tailwindcss": "3.4.3",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://www.youtube.com/*"
    ],
    "permissions": [
      "storage"
    ]
  }
}
